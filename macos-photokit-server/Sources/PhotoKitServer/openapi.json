{
  "openapi": "3.1.0",
  "info": {
    "title": "macOS PhotoKit Server",
    "version": "0.1.0",
    "description": "Read-only HTTP API for the macOS Photos library, served on 127.0.0.1.\n\n- Asset and album IDs are PhotoKit local identifiers. They contain `/`, so URL-encode them in paths (`/` -> `%2F`).\n- JSON keys are snake_case and dates are ISO 8601. Properties without a value are omitted rather than set to null.\n- String values derived from PhotoKit enums may be `unknown` or `unknown_<n>` for values added in future macOS versions."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {},
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/library": {
      "get": {
        "operationId": "getLibrary",
        "summary": "Authorization status and library overview",
        "description": "Available even without Photos access, to check the authorization status.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Library"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/assets": {
      "get": {
        "operationId": "listAssets",
        "summary": "List assets",
        "parameters": [
          {
            "$ref": "#/components/parameters/MediaType"
          },
          {
            "$ref": "#/components/parameters/Subtype"
          },
          {
            "$ref": "#/components/parameters/Favorite"
          },
          {
            "$ref": "#/components/parameters/Hidden"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Sort"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/assets/{id}": {
      "get": {
        "operationId": "getAsset",
        "summary": "Asset metadata",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/assets/{id}/resources": {
      "get": {
        "operationId": "listAssetResources",
        "summary": "Files making up the asset",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Resource"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/assets/{id}/resources/{index}": {
      "get": {
        "operationId": "getAssetResource",
        "summary": "Contents of a resource file",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "`index` from the resource list"
          },
          {
            "$ref": "#/components/parameters/Network"
          },
          {
            "$ref": "#/components/parameters/Range"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "206": {
            "$ref": "#/components/responses/PartialFile"
          },
          "416": {
            "description": "The Range header cannot be satisfied",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                },
                "description": "`bytes */<size>`"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/NetworkAccessRequired"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/assets/{id}/original": {
      "get": {
        "operationId": "getAssetOriginal",
        "summary": "Original (unedited) file",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          },
          {
            "$ref": "#/components/parameters/Network"
          },
          {
            "$ref": "#/components/parameters/Range"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "206": {
            "$ref": "#/components/responses/PartialFile"
          },
          "416": {
            "description": "The Range header cannot be satisfied",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                },
                "description": "`bytes */<size>`"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/NetworkAccessRequired"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/assets/{id}/rendered": {
      "get": {
        "operationId": "getAssetRendered",
        "summary": "Current (edited) file",
        "description": "Returns the rendered file from the library if the asset is edited, rendering it on the fly when the library has none (videos are re-encoded as HEVC .mov, which takes time proportional to their length). Unedited assets return the original.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          },
          {
            "$ref": "#/components/parameters/Network"
          },
          {
            "$ref": "#/components/parameters/Range"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "206": {
            "$ref": "#/components/responses/PartialFile"
          },
          "416": {
            "description": "The Range header cannot be satisfied",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                },
                "description": "`bytes */<size>`"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/NetworkAccessRequired"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/assets/{id}/thumbnail": {
      "get": {
        "operationId": "getAssetThumbnail",
        "summary": "Thumbnail scaled to fit within size x size pixels",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssetID"
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 16,
              "maximum": 4096,
              "default": 512
            },
            "description": "Maximum width and height in pixels"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "jpeg",
                "heic",
                "png"
              ],
              "default": "jpeg"
            }
          },
          {
            "name": "quality",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.8
            },
            "description": "Compression quality for jpeg / heic"
          },
          {
            "$ref": "#/components/parameters/Network"
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/heic": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/NetworkAccessRequired"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/albums": {
      "get": {
        "operationId": "listAlbums",
        "summary": "List albums",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated album types to include: `user`, `smart`, `shared`. Defaults to all",
            "example": "user,shared"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Album"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/albums/{id}": {
      "get": {
        "operationId": "getAlbum",
        "summary": "Album metadata",
        "parameters": [
          {
            "$ref": "#/components/parameters/AlbumID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Album"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/albums/{id}/assets": {
      "get": {
        "operationId": "listAlbumAssets",
        "summary": "List assets in an album",
        "parameters": [
          {
            "$ref": "#/components/parameters/AlbumID"
          },
          {
            "$ref": "#/components/parameters/MediaType"
          },
          {
            "$ref": "#/components/parameters/Subtype"
          },
          {
            "$ref": "#/components/parameters/Favorite"
          },
          {
            "$ref": "#/components/parameters/Hidden"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          },
          {
            "$ref": "#/components/parameters/Sort"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    },
    "/changes": {
      "get": {
        "operationId": "getChanges",
        "summary": "Changes since a token",
        "description": "Without `since`, returns the current token with empty changes. With `since`, returns the net changes after that token and a new token to use next time.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "`token` from a previous response (or `change_token` from /library)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "410": {
            "$ref": "#/components/responses/ChangeTokenExpired"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/NotAuthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required only when the server is started with --token"
      }
    },
    "parameters": {
      "AssetID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Asset local identifier (URL-encoded)",
        "example": "6859F514-7DB7-4C6B-8459-17F0633EF96D%2FL0%2F001"
      },
      "AlbumID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Album local identifier (URL-encoded)"
      },
      "Network": {
        "name": "network",
        "in": "query",
        "schema": {
          "type": "boolean"
        },
        "description": "Whether to download files that are only in iCloud. Defaults to the server's --network / --no-network setting"
      },
      "Range": {
        "name": "Range",
        "in": "header",
        "schema": {
          "type": "string"
        },
        "description": "A single byte range (`bytes=a-b`, `bytes=a-`, `bytes=-n`)"
      },
      "MediaType": {
        "name": "media_type",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated media types (`image`, `video`, `audio`); matches any",
        "example": "image,video"
      },
      "Subtype": {
        "name": "subtype",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated subtypes; matches any. `panorama`, `hdr`, `screenshot`, `live_photo`, `depth_effect`, `animation`, `spatial`, `streamed`, `high_frame_rate`, `timelapse`, `screen_recording`, `cinematic`",
        "example": "live_photo"
      },
      "Favorite": {
        "name": "favorite",
        "in": "query",
        "schema": {
          "type": "boolean"
        }
      },
      "Hidden": {
        "name": "hidden",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "exclude",
            "include",
            "only"
          ],
          "default": "exclude"
        },
        "description": "How to treat hidden assets"
      },
      "From": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Creation date lower bound (inclusive). ISO 8601 date-time, or a date in the local time zone",
        "example": "2025-01-01"
      },
      "To": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Creation date upper bound (exclusive). ISO 8601 date-time, or a date in the local time zone"
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "created_at",
            "-created_at",
            "modified_at",
            "-modified_at",
            "added_at",
            "-added_at"
          ],
          "default": "-created_at"
        },
        "description": "Sort key; prefix with `-` for descending"
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "`next_cursor` from the previous page. Pass the same filters and sort as before"
      }
    },
    "responses": {
      "File": {
        "description": "File contents. Content-Type depends on the file (image/heic, image/jpeg, video/quicktime, ...)",
        "headers": {
          "Content-Disposition": {
            "schema": {
              "type": "string"
            },
            "description": "Present when the file has a name"
          },
          "Accept-Ranges": {
            "schema": {
              "type": "string",
              "const": "bytes"
            }
          }
        },
        "content": {
          "*/*": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "PartialFile": {
        "description": "Requested byte range of the file",
        "headers": {
          "Content-Range": {
            "schema": {
              "type": "string"
            },
            "description": "`bytes a-b/size`"
          }
        },
        "content": {
          "*/*": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid parameter (`bad_request`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token (`unauthorized`). Only when the server is started with --token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Asset, album or resource not found (`not_found`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NetworkAccessRequired": {
        "description": "The file is only in iCloud and network access is not allowed (`network_access_required`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ChangeTokenExpired": {
        "description": "The change token is older than the available history; fetch everything again (`change_token_expired`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotAuthorized": {
        "description": "The server has no access to the Photos library (`not_authorized`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Timeout": {
        "description": "Timed out while loading the file (`timeout`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Library": {
        "type": "object",
        "properties": {
          "authorization": {
            "type": "string",
            "enum": [
              "not_determined",
              "restricted",
              "denied",
              "authorized",
              "limited",
              "unknown"
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "image": {
                "type": "integer"
              },
              "video": {
                "type": "integer"
              },
              "audio": {
                "type": "integer"
              }
            },
            "required": [
              "image",
              "video",
              "audio"
            ],
            "description": "Absent without Photos access"
          },
          "change_token": {
            "type": "string",
            "description": "Current change token for /changes. Absent without Photos access"
          }
        },
        "required": [
          "authorization"
        ]
      },
      "AssetPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Pass as `cursor` for the next page. Absent on the last page"
          }
        },
        "required": [
          "items"
        ]
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Local identifier"
          },
          "cloud_identifier": {
            "type": "string",
            "description": "Identifier shared across devices with iCloud Photos"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "unknown"
            ]
          },
          "media_subtypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values as in the `subtype` filter"
          },
          "playback_style": {
            "type": "string",
            "description": "`unsupported`, `image`, `image_animated`, `live_photo`, `video`, `video_looping`"
          },
          "content_type": {
            "type": "string",
            "example": "public.heic",
            "description": "Uniform Type Identifier"
          },
          "pixel_width": {
            "type": "integer"
          },
          "pixel_height": {
            "type": "integer"
          },
          "duration": {
            "type": "number",
            "description": "Seconds. Videos and audio only"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation date"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification date"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "description": "Date added to the library"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "altitude": {
                "type": "number",
                "description": "Meters"
              }
            },
            "required": [
              "latitude",
              "longitude"
            ]
          },
          "is_favorite": {
            "type": "boolean"
          },
          "is_hidden": {
            "type": "boolean"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Star rating. Absent when unset"
          },
          "caption": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "original_filename": {
            "type": "string"
          },
          "burst_identifier": {
            "type": "string"
          },
          "represents_burst": {
            "type": "boolean"
          },
          "source_type": {
            "type": "string",
            "description": "`user_library`, `cloud_shared`, `itunes_synced`"
          },
          "has_adjustments": {
            "type": "boolean",
            "description": "Edited in Photos"
          },
          "adjusted_at": {
            "type": "string",
            "format": "date-time",
            "description": "Date of the last edit (or revert)"
          }
        },
        "required": [
          "id",
          "media_type",
          "media_subtypes",
          "playback_style",
          "content_type",
          "pixel_width",
          "pixel_height",
          "is_favorite",
          "is_hidden",
          "keywords",
          "represents_burst",
          "source_type",
          "has_adjustments"
        ]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Use with /assets/{id}/resources/{index}"
          },
          "type": {
            "type": "string",
            "description": "`photo`, `video`, `audio`, `alternate_photo`, `full_size_photo`, `full_size_video`, `adjustment_data`, `adjustment_base_photo`, `paired_video`, `full_size_paired_video`, `adjustment_base_paired_video`, `adjustment_base_video`, `photo_proxy`"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "description": "Uniform Type Identifier"
          },
          "mime_type": {
            "type": "string"
          },
          "pixel_width": {
            "type": "integer"
          },
          "pixel_height": {
            "type": "integer"
          },
          "data_size": {
            "type": "integer",
            "description": "Bytes, when known"
          }
        },
        "required": [
          "index",
          "type",
          "content_type"
        ]
      },
      "Album": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Local identifier"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "user",
              "smart",
              "shared"
            ]
          },
          "subtype": {
            "type": "string",
            "description": "PhotoKit album subtype, e.g. `regular`, `cloud_shared`, `favorites`, `recently_added`, `screenshots`"
          },
          "folder_path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Titles of the enclosing folders, outermost first"
          },
          "asset_count": {
            "type": "integer"
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "subtype",
          "folder_path",
          "asset_count"
        ]
      },
      "Changes": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Pass as `since` next time"
          },
          "assets": {
            "$ref": "#/components/schemas/ChangeDetails"
          },
          "albums": {
            "$ref": "#/components/schemas/ChangeDetails"
          }
        },
        "required": [
          "token",
          "assets",
          "albums"
        ]
      },
      "ChangeDetails": {
        "type": "object",
        "properties": {
          "inserted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deleted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "inserted",
          "updated",
          "deleted"
        ]
      }
    }
  }
}
